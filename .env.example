DATABASE_URL=
ADMIN_PASSWORD=
# Host accounts: configure Google OAuth and apply migration 020 first.
# Server-only. Use a different high-entropy secret for each environment.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://www.haveashindig.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# invite-only (default) or public. Invalid modes block Google host access.
HOST_REGISTRATION_MODE=invite-only
# false pauses ALL new accounts, while eligible existing hosts can still sign in.
# Missing defaults to true; empty/invalid values pause signups. Redeploy to apply.
HOST_SIGNUPS_ENABLED=true
# Used only in invite-only mode, for both new AND existing host access.
# Comma-separated exact Google email addresses. Empty = none; no wildcards.
HOST_ALLOWED_EMAILS=
BLOB_READ_WRITE_TOKEN=
# Separate PRIVATE store for unpublished event-draft artwork. Server-only.
EVENT_DRAFT_BLOB_READ_WRITE_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional ISO 3166-1 alpha-2 country code; defaults to US.
SPOTIFY_MARKET=US
# Optional for commercial use; historical data requires an eligible paid plan.
# Leave empty for Open-Meteo's non-commercial API. Never use NEXT_PUBLIC_.
OPEN_METEO_API_KEY=
